{
  "defaults": {
    "system": "homelab",
    "every": "1h",
    "timeout": "10s",
    "retries": 2,
    "backoff": "1s",
    "concurrency": 4
  },
  "groups": [
    {
      "name": "external-apis",
      "mode": "parallel",
      "concurrency": 4
    },
    {
      "name": "cluster-images",
      "mode": "serial"
    }
  ],
  "targets": [
    {
      "name": "example_service",
      "label": "Example service",
      "type": "http",
      "group": "external-apis",
      "url": "https://example.com/api/version",
      "jsonpath": "$.version",
      "every": "1h"
    },
    {
      "name": "kubernetes_images",
      "label": "Kubernetes container image",
      "type": "kubernetes",
      "group": "cluster-images",
      "every": "5m",
      "nodes": true,
      "latest": {
        "every": "6h",
        "checkDigests": "all",
        "ignoreTags": [
          "linuxserver/qbittorrent:(20\\.04\\.1|14\\.3\\.9)$"
        ]
      }
    },
    {
      "name": "docker_containers",
      "label": "Docker container image",
      "type": "docker",
      "group": "cluster-images",
      "endpoint": "http://docker-socket-proxy:2375",
      "every": "5m",
      "latest": {
        "every": "6h",
        "upstreams": [
          {
            "match": "^registry\\.lan:5000/gha-runner:",
            "repository": "myoung34/github-runner"
          }
        ]
      }
    }
  ]
}
